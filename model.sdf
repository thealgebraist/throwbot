<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="outrunner_buggy_20cm">
    <pose>0 0 0.05 0 0 0</pose>

    <!-- Central IP67 Junction Box Chassis (140 x 90 x 50 mm, 0.52 kg) -->
    <link name="chassis">
      <inertial>
        <mass>0.52</mass>
        <inertia>
          <ixx>0.00046</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00096</iyy><iyz>0</iyz>
          <izz>0.00120</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>0.140 0.090 0.050</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>0.140 0.090 0.050</size></box></geometry>
        <material>
          <ambient>0.15 0.18 0.22 1</ambient>
          <diffuse>0.20 0.25 0.30 1</diffuse>
        </material>
      </visual>
      <!-- Smoked Clear Lid -->
      <visual name="lid_visual">
        <pose>0 0 0.026 0 0 0</pose>
        <geometry><box><size>0.132 0.082 0.004</size></box></geometry>
        <material>
          <ambient>0.1 0.4 0.6 0.6</ambient>
          <diffuse>0.2 0.6 0.8 0.6</diffuse>
        </material>
      </visual>
    </link>

    <!-- Wheel Macro Template: Ø96 mm x 36 mm (radius 0.048 m), 0.10 kg each -->
    <!-- FRONT LEFT (FL) -->
    <link name="wheel_fl">
      <pose>0.0525 0.062 0 -1.5708 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.000068</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000068</iyy><iyz>0</iyz>
          <izz>0.000115</izz>
        </inertia>
      </inertial>
      <collision name="col_fl">
        <geometry><cylinder><radius>0.048</radius><length>0.036</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_fl">
        <geometry><cylinder><radius>0.048</radius><length>0.036</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="joint_fl" type="revolute">
      <parent>chassis</parent><child>wheel_fl</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- REAR LEFT (RL) -->
    <link name="wheel_rl">
      <pose>-0.0525 0.062 0 -1.5708 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.000068</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000068</iyy><iyz>0</iyz>
          <izz>0.000115</izz>
        </inertia>
      </inertial>
      <collision name="col_rl">
        <geometry><cylinder><radius>0.048</radius><length>0.036</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_rl">
        <geometry><cylinder><radius>0.048</radius><length>0.036</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="joint_rl" type="revolute">
      <parent>chassis</parent><child>wheel_rl</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- FRONT RIGHT (FR) -->
    <link name="wheel_fr">
      <pose>0.0525 -0.062 0 -1.5708 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.000068</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000068</iyy><iyz>0</iyz>
          <izz>0.000115</izz>
        </inertia>
      </inertial>
      <collision name="col_fr">
        <geometry><cylinder><radius>0.048</radius><length>0.036</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_fr">
        <geometry><cylinder><radius>0.048</radius><length>0.036</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="joint_fr" type="revolute">
      <parent>chassis</parent><child>wheel_fr</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- REAR RIGHT (RR) -->
    <link name="wheel_rr">
      <pose>-0.0525 -0.062 0 -1.5708 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.000068</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000068</iyy><iyz>0</iyz>
          <izz>0.000115</izz>
        </inertia>
      </inertial>
      <collision name="col_rr">
        <geometry><cylinder><radius>0.048</radius><length>0.036</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_rr">
        <geometry><cylinder><radius>0.048</radius><length>0.036</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="joint_rr" type="revolute">
      <parent>chassis</parent><child>wheel_rr</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- 4WD Skid-Steer DiffDrive Plugin (Gazebo Sim) -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>joint_fl</left_joint>
      <left_joint>joint_rl</left_joint>
      <right_joint>joint_fr</right_joint>
      <right_joint>joint_rr</right_joint>
      <wheel_separation>0.124</wheel_separation>
      <wheel_radius>0.048</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
    </plugin>
  </model>
</sdf>
