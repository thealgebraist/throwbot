<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="buggy_test_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 20 mm Test Curb / Obstacle -->
    <model name="curb_20mm">
      <static>true</static>
      <pose>0.60 0 0.010 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.08 1.2 0.020</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.08 1.2 0.020</size></box></geometry>
          <material><ambient>0.7 0.3 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 15-Degree Test Ramp -->
    <model name="ramp_15deg">
      <static>true</static>
      <pose>1.50 0 0.065 0 -0.2618 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.60 0.80 0.02</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.60 0.80 0.02</size></box></geometry>
          <material><ambient>0.2 0.5 0.3 1</ambient><diffuse>0.2 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Include the 20 cm Outrunner Buggy -->
    <include>
      <uri>file:///Users/anders/.gemini/antigravity/scratch/outrunner_buggy_sim/model.sdf</uri>
      <pose>0 0 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>
